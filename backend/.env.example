PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
NODE_ENV=production
# Dominios que pueden llamar a la API, separados por coma. Si se deja vacío,
# CORS queda abierto (conveniente en desarrollo, no recomendado en producción).
FRONTEND_ORIGIN=https://tudominio.com
# Actívalo si despliegas detrás de un proxy como Nginx (ver README) — si no,
# el rate limiter de login/registro cuenta a todos los visitantes como una
# sola IP y termina bloqueando a todo el sitio en vez de solo al atacante.
TRUST_PROXY=1
# Notificaciones push (opcional). Genera tu propio par con:
#   npx web-push generate-vapid-keys
# Sin esto configurado, la app funciona igual pero sin avisos push del
# sistema operativo (solo el mensaje dentro del dashboard abierto).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com

# Asistente de hidratación (opcional). Crea una key gratis en
# https://console.groq.com — sin esto, la app funciona igual pero sin el
# asistente conversacional.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
